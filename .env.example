# Copy to .env and fill in values. Never commit .env.
SUNIQ_SECRET_KEY=
SUNIQ_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Optional local presentation only. Production always disables it.
SUNIQ_PRESENTATION_LOGIN=false

# Approved password account, also supported in production. Store only a Werkzeug hash.
SUNIQ_ACCOUNT_EMAIL=
SUNIQ_ACCOUNT_PASSWORD_HASH=
