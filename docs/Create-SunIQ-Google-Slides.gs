/**
 * SunIQ: portable Google Slides creator.
 * Paste this entire file into Code.gs at https://script.google.com/.
 * Edit CONFIG below, select createSunIQSlides, and click Run.
 * Uses Google's built-in Slides service. No API key, package, or local app required.
 * Each run creates a new private presentation in the signed-in Google account.
 * Three app screenshots are embedded below, so this file works on another computer.
 * No inverter credentials, serial numbers, or account passwords are embedded.
 */
const CONFIG = {
  deckTitle: 'SunIQ — Solar planning demo',
  presenterName: 'Arush', // Replace with every participant's full name before submitting.
  // Optional: a publicly accessible PNG/JPEG URL for YOUR home inverter.
  // Leave blank to use a clean text slide. Mask the serial number in the photo.
  homeInverterImageUrl: ''
};

function createSunIQSlides() {
  const deck = SlidesApp.create(CONFIG.deckTitle);
  const initialSlides = deck.getSlides();
  const w = deck.getPageWidth(), h = deck.getPageHeight();
  const sx = w / 720, sy = h / 405;
  const colors = { background:'#FAFBF6', ink:'#153F30', muted:'#486151', accent:'#44805C' };

  function text(slide, value, x, y, width, height, size, color, bold) {
    const shape = slide.insertTextBox(value, x*sx, y*sy, width*sx, height*sy);
    shape.getText().getTextStyle().setFontFamily('Arial').setFontSize(size*sx)
      .setForegroundColor(color).setBold(Boolean(bold));
    return shape;
  }
  function fitImage(image, x, y, width, height) {
    const ratio = image.getWidth()/image.getHeight();
    const targetW = Math.min(width*sx, height*sy*ratio);
    const targetH = targetW/ratio;
    image.setWidth(targetW).setHeight(targetH)
      .setLeft(x*sx+(width*sx-targetW)/2).setTop(y*sy+(height*sy-targetH)/2);
  }

  SUNIQ_SLIDES.forEach(function(item, index) {
    const slide = deck.appendSlide(SlidesApp.PredefinedLayout.BLANK);
    slide.getBackground().setSolidFill(colors.background);
    text(slide, 'SUNIQ / '+String(index+1).padStart(2,'0'), 38, 20, 630, 20, 11, colors.accent, true);
    const isCover = index===0;
    text(slide, item.title, 38, isCover?82:57, 644, isCover?75:57,
      isCover?54:35, colors.ink, true);

    let hasImage = Boolean(item.image);
    let image = null;
    if (index===2 && CONFIG.homeInverterImageUrl) {
      // Fetches only the image URL explicitly configured by the person running this script.
      image = slide.insertImage(CONFIG.homeInverterImageUrl);
      hasImage = true;
    } else if (item.image) {
      const blob=Utilities.newBlob(Utilities.base64Decode(item.image),'image/png','SunIQ-'+(index+1)+'.png');
      image=slide.insertImage(blob);
    }
    const copyWidth = hasImage?300:644;
    text(slide, item.body, 38, isCover?177:130, copyWidth, isCover?125:182,
      isCover?30:(hasImage?20:24), colors.ink, false);
    if (image) fitImage(image, 365, 128, 317, 190);
    const foot = isCover ? CONFIG.presenterName : (index===2 ? 'Home solar inverter' : item.foot);
    text(slide, foot, 38, isCover?326:340, 644, 43, isCover?20:12, colors.muted, false);
    text(slide, String(index+1)+' / '+SUNIQ_SLIDES.length, 636, 383, 46, 16, 10, colors.muted, false);

    let narration = item.narration;
    if (index===0) narration=narration.replace('Arush [last name]',CONFIG.presenterName);
    const speakerNotes = 'SAY\n'+narration+'\n\nSHOW\n'+item.cue+
      '\n\nPRESENTER REMINDER\n'+
      (index===3 ? 'Serial-number entry saves session setup details. It is not a live inverter connection. ' : '')+
      (index===6 ? 'This search describes the single-appliance planner. The multi-appliance planner is not guaranteed globally optimal. ' : '')+
      (index===7 ? 'Add your own truthful coding contribution and learning; disclose AI assistance accurately. ' : '')+
      'Home forecasts and household readings are sample data. Appliances remain manually operated.'+
      '\n\n[Sources]\nFeature claims and screenshots: local SunIQ project, inspected October 25, 2026. '+
      'solar_portal.py; appliance_planner.py; templates/signin.html; templates/demo_setup.html; '+
      'templates/solar_demo.html; templates/day_planner.html; templates/planner.html. '+
      'No measured bill savings or live provider integration claimed.\n[/Sources]';
    const notesShape=slide.getNotesPage().getSpeakerNotesShape();
    if (!notesShape) throw new Error('Could not find speaker notes for slide '+(index+1));
    notesShape.getText().setText(speakerNotes);
  });
  // Only remove starter slides from the NEW presentation created above.
  initialSlides.forEach(function(slide){slide.remove();});
  const url=deck.getUrl();
  deck.saveAndClose();
  console.log('SunIQ deck created: '+url);
  console.log('Review all 8 slides, personalize the names and coding contribution, and rehearse under 3 minutes.');
  return url;
}

